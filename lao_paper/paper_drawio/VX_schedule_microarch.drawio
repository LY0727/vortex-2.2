                <mxCell id="note_priority" value="&lt;b&gt;Stall/Unlock Priority (always @*)&lt;/b&gt;&lt;br&gt;Update order in code:&lt;br&gt;1) unlock events: wspawn/tmc/split/join/barrier/branch/decode/csr&lt;br&gt;2) then schedule_fire: stalled_warps_n[schedule_wid] = 1&lt;br&gt;&lt;br&gt;&lt;b&gt;Net effect:&lt;/b&gt; if same cycle has unlock + schedule_fire&lt;br&gt;on same wid, stall wins in next state." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#f9a825;strokeWidth=2;fontFamily=Helvetica;fontColor=#5d4037;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="710" y="1180" width="430" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="note_fire_diff" value="&lt;b&gt;schedule_fire vs schedule_if_fire&lt;/b&gt;&lt;br&gt;&lt;b&gt;schedule_fire&lt;/b&gt; = schedule_valid &amp;amp; schedule_ready&lt;br&gt;- handshake at selector -&amp;gt; out_buf input&lt;br&gt;- used to set stalled_warps_n[schedule_wid]=1&lt;br&gt;&lt;br&gt;&lt;b&gt;schedule_if_fire&lt;/b&gt; = schedule_if.valid &amp;amp; schedule_if.ready&lt;br&gt;- handshake at out_buf output&lt;br&gt;- used to advance warp_pcs (+2) and pending per-warp incr" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3949ab;strokeWidth=2;fontFamily=Helvetica;fontColor=#1a237e;fontSize=11;" vertex="1" parent="1">
