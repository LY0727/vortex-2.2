    <diagram id="aP_V4VSkA2B4vL_YjUzs" name="core_new_25-11">
        <mxGraphModel dx="7785" dy="616" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="OF8jFwYP2XrNe-weMfz_-2" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-2310" y="360" width="812.57" height="550" as="geometry"/>
                </mxCell>
                <mxCell id="OF8jFwYP2XrNe-weMfz_-3" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Warp调度级：&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;1.调度算法只是 轮询仲裁；主要是看控制流。&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;2.sched后马上stalled该warp，decode级译码后可unlock该warp；思考意义。&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;3.维护的各表项的对应关系。&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-1480" y="360" width="560" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="OF8jFwYP2XrNe-weMfz_-4" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-1480" y="570" width="555.43" height="336.43" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-5230" y="180" width="658.03" height="312.32" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-2" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-2300" y="1000" width="717" height="303.59" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-3" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-2300" y="1320" width="715.33" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-4" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-2300" y="1620" width="407" height="686.95" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-5" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-740" y="275.00000000000017" width="463" height="618.49" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-6" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;fetch级：&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;1.没什么好说的，请求应答总线对外引出。&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;2.icache组件设计为一个socket内的多个core共享，core设计这里先不考虑。&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-1520" y="1000" width="560" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-7" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Decode级：&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;1.Decode逻辑本身也没有太多说法，注意一下时序优化设计。&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;2.需要关注Decode_sched_if.unlock这个逻辑。&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-1520" y="1240" width="560" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-8" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;issue级： （注意目前发射宽度为1，按序发射）&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;1.ibuffer：没什么讲究，等效于fifo即可。&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;2.socreboard：主要是RAW检测，GPGPU逻辑下的记分板也比较简单，因为做按序发射，只需要对ibuffer队首的instr做检测？&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;3,operands：操作数收集应该要关注一下regfile的设计。&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;理清几个数量：（举例）&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;1.NUM_WARPS: &lt;/b&gt;一个core内支持多少个warp硬件并行。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;2.NUM_THREADS:&amp;nbsp;&amp;nbsp;&lt;/b&gt;线程并行度，每个thread都有regfile。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;4.ISSUE_WIDTH: &lt;/b&gt;每周期发射指令数，当一个core内warp并行度很高时，后端发射执行提交环节考虑增加硬件，支持core内同时执行多组warp逻辑。vortex中设计为num_warps/8。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;5.执行单元的lanes和blocks：&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;5.1 lanes对应num_threads，执行块一次就可以执行完整个warps&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;5.2 blocks对于ALU单元应与issue匹配，但对于SFU、LSU等没有必要。&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-240" y="280" width="560" height="550" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-9" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-740" y="919.56" width="525" height="400.44" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-10" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;scoreboard：&amp;nbsp;&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;1.注意：每个thread硬件都对应一套独立的regfile，而SI机制说明每个warp中的多个thread执行同一指令，即RAW情况是一致的，每个warp只需要一个scoreboard硬件。&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;2.状态更新：inuse_regs[rd] 表格记录WR操作待完成的寄存器标号，writeback写回完成时，清空该标志。&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;3.依赖检查：检查指令的rs1、rs2、rs3等源操作数寄存器，与inuse_regs表格进行check，命中说明存在RAW冲突。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;4.operands_ready信号：所有源操作数均无RAW冲突，才可以到下一步。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;寄存器编号：&amp;nbsp; {rtype[1:0],idx[4:0]}&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;1. 整数32个寄存器，浮点32个寄存器，rtype字段区分。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-150" y="919.56" width="560" height="400.44" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-11" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-740" y="1360" width="863" height="347.72" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-12" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;操作数收集逻辑：&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;1.这里的逻辑需要再细看。 新版本 抽象成了两级，VX_operands 和 VX_opc_unit，config中参数配置 NUM_OPC； 旧版本其实就是单独的VX_operands，往上看代码可以看出，每个issue单元都只有一个 operands。&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;2.主要原因还是新版本加了 SIMD_WIDTH 抽象，SIMD_WIDTH 配置得小于 NUM_THREAD时会有多次迭代完成一直warp的操作，由SID信号标志这个迭代执行操作。&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;3.旧版本 执行单元的lanes数量一定等于 num_warps，所以没有SIMD迭代执行的操作流。&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="160" y="1360" width="560" height="440" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-13" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-740" y="1730" width="863.37" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-14" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-680" y="2170" width="793" height="397" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-15" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="950" y="120.8" width="1167" height="525" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-16" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;br&gt;&lt;/h1&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="1900" y="235" width="610" height="510" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-17" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="1300" y="695.8" width="817" height="223.76" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-18" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;操作数收集逻辑：&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;1.这个逻辑本身，新老版本应该是基本一致的。&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="150" y="1970" width="560" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-19" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="880" y="1160" width="1237" height="700.62" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-20" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;execute级： （dispatch and computation）&lt;/font&gt;&lt;/h1&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;1. elastic_buffer深度为2，隔离执行单元 与 操作数阶段。&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;2. 设计有stall counters 跟踪指令被阻塞等待特定执行单元的周期数。&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font size=&quot;3&quot;&gt;ALU需要评估分支结果：&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font size=&quot;3&quot;&gt;3. ALU里面分支指令，注意有反馈回路到schedule单元。&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font size=&quot;3&quot;&gt;4. 分支评估： 使用最后一个活跃线程的减法结果，分支决策 再通过流水线寄存器反馈到schedule。&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font size=&quot;3&quot;&gt;5. 乘除单元，我们先剔除。&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font size=&quot;3&quot;&gt;LSU设计&lt;/font&gt;：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;1.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;SFU设计：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;1. CSR访问 和 warp 控制&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;2. CSR访问就是CSR总线实现&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;3. WARP控制：&amp;nbsp; 五条指令，&amp;nbsp;&lt;/b&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="2200" y="120.79999999999995" width="560" height="550" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-21" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;commit：&amp;nbsp;&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;1.仲裁的优先级：&lt;/font&gt;&lt;span style=&quot;background-color: rgb(229, 229, 229); color: rgb(51, 51, 51); font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, &amp;quot;Liberation Mono&amp;quot;, &amp;quot;Courier New&amp;quot;, monospace; font-size: 12.58px; font-weight: 600;&quot;&gt;EX_ALU &amp;lt; EX_LSU &amp;lt; EX_SFU &amp;lt; EX_FPU&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;2. commit_csr_if：&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;3. commit_sched_if:&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;4. writeback_if:&amp;nbsp; &lt;/b&gt;写回先到发射级，先更新记分板状态和操作数收集，最后才写回GPR Banks。&lt;br&gt;&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="2180" y="1479.8" width="560" height="400.44" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-22" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="880" y="1903.5" width="910" height="256.59" as="geometry"/>
                </mxCell>
                <mxCell id="K2F-1vNpDmgFtQSGTw1W-23" value="&lt;div style=&quot;color: #d4d4d4;background-color: #1e1e1e;font-family: Consolas, &#39;Courier New&#39;, monospace;font-weight: normal;font-size: 14px;line-height: 19px;white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;typedef struct&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;packed&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt; {&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; logic&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt; [`UUID_WIDTH-&lt;/span&gt;&lt;span style=&quot;color: #b5cea8;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;color: #b5cea8;&quot;&gt;0&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;] &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; uuid;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; logic&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt; [ISSUE_WIS_W-&lt;/span&gt;&lt;span style=&quot;color: #b5cea8;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;color: #b5cea8;&quot;&gt;0&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;] &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; wis;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; logic&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt; [`NUM_THREADS-&lt;/span&gt;&lt;span style=&quot;color: #b5cea8;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;color: #b5cea8;&quot;&gt;0&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;] &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;tmask;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; logic&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt; [`PC_BITS-&lt;/span&gt;&lt;span style=&quot;color: #b5cea8;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;color: #b5cea8;&quot;&gt;0&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;] &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;PC;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; logic&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt; [`NR_BITS-&lt;/span&gt;&lt;span style=&quot;color: #b5cea8;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;color: #b5cea8;&quot;&gt;0&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;] &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;rd;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; logic&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt; [`NUM_THREADS-&lt;/span&gt;&lt;span style=&quot;color: #b5cea8;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;color: #b5cea8;&quot;&gt;0&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;][`XLEN-&lt;/span&gt;&lt;span style=&quot;color: #b5cea8;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;color: #b5cea8;&quot;&gt;0&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;] data;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; logic&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; sop;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; logic&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; eop;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;&amp;nbsp; &amp;nbsp; } &lt;/span&gt;&lt;span style=&quot;color: #c8c8c8;&quot;&gt;data_t&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="1810" y="1920" width="410" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="7xIT4IFkscEXqY9dSgE6-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-3790" y="160" width="569" height="1267" as="geometry"/>
                </mxCell>
                <mxCell id="7xIT4IFkscEXqY9dSgE6-2" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;级间数据结构：&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;1.调度算法只是 轮询仲裁；主要是看控制流。&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;2.sched后马上stalled该warp，decode级译码后可unlock该warp；思考意义。&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;3.维护的各表项的对应关系。&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-4480" y="484.24999999999994" width="560" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="7xIT4IFkscEXqY9dSgE6-3" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-5230" y="530" width="698.69" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="7xIT4IFkscEXqY9dSgE6-4" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-5758.3099999999995" y="860" width="1227" height="735" as="geometry"/>
                </mxCell>
                <mxCell id="7xIT4IFkscEXqY9dSgE6-5" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;级间数据结构：&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;1.调度算法只是 轮询仲裁；主要是看控制流。&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;2.sched后马上stalled该warp，decode级译码后可unlock该warp；思考意义。&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;3.维护的各表项的对应关系。&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-3160" y="160" width="560" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="7xIT4IFkscEXqY9dSgE6-6" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;级间反压情况：&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;1.调度算法只是 轮询仲裁；主要是看控制流。&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;2.sched后马上stalled该warp，decode级译码后可unlock该warp；思考意义。&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;3.维护的各表项的对应关系。&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-4510" y="860" width="560" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="7xIT4IFkscEXqY9dSgE6-7" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-5758.31" y="1680" width="1297" height="1039" as="geometry"/>
                </mxCell>
                <mxCell id="7xIT4IFkscEXqY9dSgE6-8" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;流水线反馈路径：&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;1.写回RD，直接到操作数收集单元，同时写回GPR，单周期完成。&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;2. 到scoreboard更新状态，这里其实也是单周期完成，因为现在设计的是没有sid信号。&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-4420" y="1680" width="560" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="7xIT4IFkscEXqY9dSgE6-9" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-3780" y="1690" width="819" height="845" as="geometry"/>
                </mxCell>
                <mxCell id="7xIT4IFkscEXqY9dSgE6-10" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;特殊反馈路径：（分支指令和warp control）&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;1.bypass路径 两个 ctrl_if直接反馈到 schedule模块。&lt;br&gt;&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-4420" y="1920" width="560" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="7xIT4IFkscEXqY9dSgE6-11" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-5758.31" y="2800" width="1315" height="1239" as="geometry"/>
                </mxCell>
                <mxCell id="7xIT4IFkscEXqY9dSgE6-12" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;特殊反馈路径：（分支指令和warp control）&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;1.bypass路径 两个 ctrl_if直接反馈到 schedule模块。&lt;br&gt;&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-4360" y="2800" width="560" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="oWwwQc72c9v2b9Zx1LkV-1" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;我们分析的版本是2025年8月发布的vortex-2.2版本，而deepwiki解析是2025年十一月更新的。从config.vh文件的对比分析可以基本了解二者的区别：&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-6400" y="160" width="560" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="oWwwQc72c9v2b9Zx1LkV-3" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;对于CORE层面，在对比该文档资料和2.2版本的代码阅读时，要着重注意第五点内容。2.2版本实际没有sid信号，OPS单元数量配置也不一样。&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;1. issue级的理解可以差别较大。&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2. execute阶段，应该也不需要考虑sid信号控制的多周期迭代计算一个warp。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-5758.31" y="160" width="430" height="440" as="geometry"/>
                </mxCell>
                <mxCell id="oWwwQc72c9v2b9Zx1LkV-4" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;2. 向量 (Vector) 与 TCU 支持扩展&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;新版显著增加了对向量 (V) 扩展指令集和 Tensor Core Unit (TCU) 的支持：&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;新增 VLEN 定义：默认设置为 4 * XLEN。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;新增 VPU 单元配置：引入了对应向量处理单元的并发通道数 (NUM_VPU_LANES) 和块数 (NUM_VPU_BLOCKS)。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;新增 TCU 单元配置：添加了针对张量计算的单元和执行通道定义 (NUM_TCU_LANES, NUM_TCU_BLOCKS)，并且定义了 TCU 的硬件实现方式选择（DPI、BHF、DSP）。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;新增 ISA 标志位：在 MISA_STD 中正式启用了 EXT_V_ENABLED（第 21 位 V - Tensor/Vector extension），并加入了 EXT_TCU_ENABLED。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;3. 虚拟内存 (VM) 支持&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;新版增加了非常详细的虚拟内存 (VM) 配置块 // Virtual Memory Configuration，在顶层地址处也增加了对 PAGE_TABLE_BASE_ADDR 的定义：&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;定义了 32 位系统 (SV32) 和 64 位系统 (SV39) 的虚拟内存地址模式。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;包含了页表层级 (PT_LEVEL)、页表项大小 (PTE_SIZE)、页表项数量 (NUM_PTE_ENTRY)。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;新增页大小 MEM_PAGE_SIZE (4096) 基础定义和 TLB 配置 (TLB_SIZE)。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;4. 平台级内存配置解耦&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;新版中增加了独立的 // Platform memory parameters 配置区：&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;PLATFORM_MEMORY_NUM_BANKS、PLATFORM_MEMORY_ADDR_WIDTH、PLATFORM_MEMORY_DATA_SIZE (64) 和 PLATFORM_MEMORY_INTERLEAVE。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;在各级缓存配置中（L1_MEM_PORTS，L2_MEM_PORTS 等），接口和端口数均开始关联平台显存 PLATFORM_MEMORY_NUM_BANKS，这使得系统更好地适应真实的外部存储器总线和 Bank 配置。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;5. 流水线与核心配置修改&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;底层流水线微架构参数做了重要调整：&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;SIMD 抽象：新增了 SIMD_WIDTH 宏，现在 ALU/FPU/LSU/SFU 等的 Lanes（通道数）一律被定义为 SIMD_WIDTH，而不是直接关联到 NUM_THREADS。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;发射宽度 (ISSUE_WIDTH) 减半：从 UP(NUM_WARPS / 8) 修改成了 UP(NUM_WARPS / 16)，降低了宽度。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;操作数收集器 (NUM_OPCS) 与寄存器 Bank：新增了操作数收集器数量，并独立定义了通用寄存器 (NUM_GPR_BANKS) 和向量寄存器 (NUM_VGPR_BANKS) 对应的 Bank 数量。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;访存队列加深：LSUQ_IN_SIZE 计算方式做了适配调整，通过 SIMD_WIDTH 而不是 NUM_THREADS 进行绑定。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;6. Cache 系统大幅度调整升级&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;新版的 Cache 加快了性能设计，向高性能架构倾斜：&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;容量与相联度提升：&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;I-Cache：容量从 4096 恢复回 16384 字节；相联度 (ICACHE_NUM_WAYS) 从直接映射 (1) 提升为 4 路组相联；ICACHE_MRSQ_SIZE 设置归零。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;D-Cache：容量从 4096 恢复回 16384 字节；相联度从 直接映射 (1) 提升为 4 路组相联。新增 DCACHE_MRSQ_SIZE。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;L2-Cache / L3-Cache：去除了 ALTERA_S10 平台的特判逻辑，参数设置更加通用，L2 相联度设为 8，L3 设为 8。Bank 数量设置和外存请求数关联而不是核心或 Socket 数量。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;增加 Dirty Bytes 和 Repl Policy：统一显式增补了多级 Cache 替换策略（REPL_POLICY = 1，通常代表 Tree-PLRU 或 LRU），以及细粒度缓存脏标记模式 (DIRTYBYTES) 的支持参数。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;7. 移除或简化的内容&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;删除了 LATENCY_IMUL 在老版本里针对 VIVADO 和 QUARTUS 的特判，在新的流水线里由 DSP/DPI 模型统一管理或已被移入单独文件。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;L2/L3 中关于 Altera Stratix 10 (ALTERA_S10) 的判断分支被移除，归拢为标准的参数架构配置。&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#6c8ebf;fillColor=#dae8fc;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-6400" y="400" width="560" height="2050" as="geometry"/>
                </mxCell>
                <mxCell id="oWwwQc72c9v2b9Zx1LkV-5" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="2800" y="125" width="968.88" height="860" as="geometry"/>
                </mxCell>
                <mxCell id="oWwwQc72c9v2b9Zx1LkV-6" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="3790" y="130.8" width="1453" height="515" as="geometry"/>
                </mxCell>
                <mxCell id="oWwwQc72c9v2b9Zx1LkV-7" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="3790" y="670.8" width="1373" height="809" as="geometry"/>
                </mxCell>
                <mxCell id="oWwwQc72c9v2b9Zx1LkV-8" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="2470" y="1017" width="1289" height="423" as="geometry"/>
                </mxCell>
                <mxCell id="oWwwQc72c9v2b9Zx1LkV-9" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;SIMT管理&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-6480" y="4160" width="560" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="oWwwQc72c9v2b9Zx1LkV-29" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-6663" y="4350" width="733" height="189.71" as="geometry"/>
                </mxCell>
                <mxCell id="oWwwQc72c9v2b9Zx1LkV-30" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-6650" y="4560" width="1375" height="303" as="geometry"/>
                </mxCell>
                <mxCell id="oWwwQc72c9v2b9Zx1LkV-31" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-6650" y="5150" width="857" height="1023" as="geometry"/>
                </mxCell>
                <mxCell id="oWwwQc72c9v2b9Zx1LkV-32" value="&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;WARP调度逻辑：&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;1.&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 24px;&quot;&gt;wire [`NUM_WARPS-1:0] ready_warps = active_warps &amp;amp; ~stalled_warps;&amp;nbsp; &amp;nbsp; &amp;nbsp; 根据ready_warps&amp;nbsp; 直接轮询仲裁。&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;WARP stall和unlock的情况：&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 24px;&quot;&gt;1、sched调度后马上stall，防止重复调度。最快的unlock是等待解码阶段完成，是普通指令的情况下，反馈回来unlock该warp。&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 24px;&quot;&gt;2、分支指令，warp 控制指令；这类指令要一直等到执行完成 bypass反馈信号到sched才能unlock&amp;nbsp; warp。&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 24px;&quot;&gt;3、CSR指令好像也需要执行完成？&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 24px;&quot;&gt;4、Barrier 某个warp已经完成了，但是barrier涉及的其它warp还没有到达，那么这个warp也需要stall 等待屏障释放。&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 24px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 24px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;WSPAWN 指令:&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 24px;&quot;&gt;1. 查看看kernel/ 下的.c 和 start.s 更能理解该指令的功能。&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 24px;&quot;&gt;2. rs1: 激活的warp数量； rs2：激活warp的起始PC设置。&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 24px;&quot;&gt;3. 一次正常的程序执行场景大致是这样的： 启动文件初始化core后，会保持warp0的thread0 激活，单线程模式进入到main()函数，此时整个core的执行都是单线程的，在main()中会从有个时间调用&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 24px;&quot;&gt;vx_spawn_kernel（）函数，其最终体现是以&lt;b&gt;WSPAWN&lt;/b&gt;指令激活硬件上的多个warp和thread，开始并行计算。&lt;b&gt;wspawn&lt;/b&gt;指令应该只有这个场景使用，当整个task完成，这个core会回到单线程模式，此后下一次task调度才会又进行这样开启并行模式的操作。&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 24px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;rounded=0;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="-5610" y="5180" width="890" height="980" as="geometry"/>
                </mxCell>
                <mxCell id="oWwwQc72c9v2b9Zx1LkV-34" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-5200" y="4560" width="821" height="529" as="geometry"/>
                </mxCell>
                <mxCell id="oWwwQc72c9v2b9Zx1LkV-35" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-6650" y="4880" width="1370.69" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="oWwwQc72c9v2b9Zx1LkV-36" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-6650" y="6320" width="919" height="1147" as="geometry"/>
                </mxCell>
                <mxCell id="oWwwQc72c9v2b9Zx1LkV-37" value="&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;SPLIT--join逻辑：&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;1、split指令：根据分支条件的执行结果，warp会继续执行 then分支（显然这里需要更新scheduler内的tmask字段），而将else分支的 tmask和pc入栈。&amp;nbsp; &amp;nbsp;(这里的then 分支实际是 活跃线程数更多的那个分支。)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;2、IPDOM stack：这个栈是每个warp都要维护一个，栈的深度应该是 threads（对应最坏情况，每个thread都是一个分支，但这种情况其实不合理。）&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;3、压栈逻辑：更新两个内容，一是else分支的（PC，tmask）,而是 栈指针。&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;4、join指令：then分支段的代码在最后一行会插入一条join指令，执行到这里时，join指令的操作就是从 IPDOM 弹出栈顶，这里显然就有两种情况：&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;4.1、栈顶非空，那就弹出栈顶（PC，tmask），warp继续执行。&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;4.2、栈顶已空，分支程序已经完成，合并tmask。&amp;nbsp; 后续直接从下一条PC开始执行。&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;rounded=0;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="-5610" y="6320" width="890" height="450" as="geometry"/>
                </mxCell>
                <mxCell id="oWwwQc72c9v2b9Zx1LkV-38" value="&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;barrier逻辑：&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;1、只考虑core内warp之间的barrier。&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;2、两个表项在schedule模块中维护。&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;3、这里有一个问题时 barrier_masks 字段的含义：从代码来看，它只表示数量，即多少个warp被barrier，一开始可能会想到需要指明是哪些warp被barriar了， 但其实并不需要，因为被bar的warp都会执行bar指令，bar指令携带的bar ID 自然就确定了哪些warp是在同一个bar下，而warp执行了bar指令这个操作本身就代表了这个bar id下有一个warp到了，因此bar操作需要的信息就是： bar id、该bar下的收bar的warp数量，当然软件层有一个潜在含义：被bar的warp都会执行这个bar指令。&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;rounded=0;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="-5610" y="6840" width="890" height="450" as="geometry"/>
                </mxCell>
                <mxCell id="oWwwQc72c9v2b9Zx1LkV-39" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-6650" y="7509" width="1093" height="179" as="geometry"/>
                </mxCell>
                <mxCell id="oWwwQc72c9v2b9Zx1LkV-40" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;多发射的参数化设计和硬件特点&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-3960" y="5270" width="560" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="oWwwQc72c9v2b9Zx1LkV-41" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;1、目前考虑是每8个warp就加一个issue slots。&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;2、&lt;/span&gt;&lt;span style=&quot;font-size: 22px; background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193));&quot;&gt;每个issue slots对应的硬件配套是：&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px; background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193));&quot;&gt;2.1、一个完整的issue级、&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px; background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193));&quot;&gt;2.2、execute级中参数化配置unit的block数量，&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px; background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193));&quot;&gt;2.3、commit级：&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px; background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193));&quot;&gt;2.4、GPR：&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#666666;fillColor=#f5f5f5;align=center;verticalAlign=middle;rounded=0;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="-3970" y="5470" width="880" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="oWwwQc72c9v2b9Zx1LkV-42" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-3780" y="2590" width="842.16" height="1633" as="geometry"/>
                </mxCell>
                <mxCell id="WWNmlEfdcUXsPoB-tXn9-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-3160" y="6600" width="1215" height="279" as="geometry"/>
                </mxCell>
                <mxCell id="WWNmlEfdcUXsPoB-tXn9-2" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;regFile：&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;1、使用DPRAM，分bank设计&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;2、参数NUM_REGS：每个线程的reg数，I和F各32个。寄存器的编码 {type[1:0],addr[4:0]}&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;3、参数NUM_GPR_BANKS：新版本加了这个配置参数，但是旧版本是再 VX_operands.sv中直接写死了分4bank。 新老版本再issue阶段确实有一些差异。&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;4、reg addr = {bank_id，addr_within_bank}，其实这种关系应该在代码中直接体现了？具体要再看代码。&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;regFile的组织形式：&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;1. 读优先&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;2. 读出延迟一个cycle&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;3. 多bank设计中，寄存器的交错映射形式。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-3960" y="5920" width="560" height="560" as="geometry"/>
                </mxCell>
                <mxCell id="WWNmlEfdcUXsPoB-tXn9-3" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-5731" y="4050" width="1235" height="473" as="geometry"/>
                </mxCell>
                <mxCell id="GBtG_C_lq5dk7jcXJ7r0-1" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;操作数收集：&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;1、 有一个问题，RISCV的 IMAFDC等等指令集应该都是只有2个RS寄存器，vortex自定义的6条指令也都没有三个RS，不知道这里文档途中一直显示了三个RS寄存器是什么原因，后续需要看一下代码确定。&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;2.bank 冲突处理： OPC反压，流水线停顿，一般只有一个周期，但也可能反复冲突。&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;3.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-3160" y="5920" width="560" height="310" as="geometry"/>
                </mxCell>
                <mxCell id="xLn6EfFlj_Thag6cUgo_-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-780.95" y="1960.41" width="904.32" height="169.59" as="geometry"/>
                </mxCell>
                <mxCell id="xLn6EfFlj_Thag6cUgo_-2" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-3870" y="6710" width="604.5" height="592.02" as="geometry"/>
                </mxCell>
                <mxCell id="utzsHjsYpxd7lNv6E9BA-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-2600" y="4450" width="1655" height="1131" as="geometry"/>
                </mxCell>
                <mxCell id="XPKQ51gJvrO42FkWezHO-15" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;TMC #tmask：参数就是要设置的tmask的值，指令自带。&lt;br&gt;pred #pred，#tmask： 第一个参数是判断语句结果，硬件上体现为谓词寄存器。&lt;br&gt;wspawn #wmask，%PC：第一个参数要激活的warp的掩码；第二个参数是激活warp的起始程序执行地址。&lt;br&gt;#addr &amp;lt;- split #pred： 第一个返回值（rd）是该条目在IPDOM栈中的栈指针；第二个参数是判断语句的结果。&lt;/font&gt;&lt;div&gt;&lt;span style=&quot;font-size: 24px;&quot;&gt;join #addr：对应split的返回值。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 24px;&quot;&gt;bar #id，#warps：屏障ID，参与该屏障的warp数量。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-4469" y="4150" width="560" height="370" as="geometry"/>
                </mxCell>
                <mxCell id="UEzuD8nOCwgNnwBchdQG-2" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-6632.15" y="7840" width="1335" height="1023" as="geometry"/>
                </mxCell>
                <mxCell id="UEzuD8nOCwgNnwBchdQG-3" value="&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;理解分支发散的执行过程：&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;1、&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;rounded=0;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="-5240" y="7840" width="890" height="450" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
