    <diagram id="vx_gpr_mapping" name="GPR Bank Mapping Architecture">
        <mxGraphModel dx="876" dy="1751" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
