                    <mxGeometry x="340" y="80" width="680" height="610" as="geometry"/>
                </mxCell>
                <mxCell id="title" value="VX_operands: GPR SRAM Multi-Bank Mapping Strategy" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontFamily=Helvetica;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="220" y="-10" width="600" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="info_box" value="&lt;b&gt;Parameters (Default)：&lt;/b&gt;&lt;div&gt;&lt;ul style=&quot;text-align:left;&quot;&gt;&lt;li&gt;&lt;b style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;NUM_REGS&lt;/b&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt; = 32 (r0 - r31)&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;NUM_BANKS&lt;/b&gt; = 4&lt;/li&gt;&lt;li&gt;&lt;b&gt;PER_ISSUE_WARPS&lt;/b&gt; = 4 (wis: 0-3)&lt;/li&gt;&lt;li&gt;&lt;b&gt;NUM_THREADS&lt;/b&gt; = 32 threads/warp&lt;/li&gt;&lt;li&gt;&lt;b&gt;Data Width &lt;/b&gt;&amp;nbsp;= 32 * 32-bit = 1024 Bits!&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="50" y="80" width="270" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="decode_sys" value="Address Generation &amp; Decoding Logic&#xa;req_in_valid / req_in_data / req_bank_idx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0050ef;strokeWidth=2;dashed=1;verticalAlign=top;spacingTop=10;fontFamily=Helvetica;fontSize=14;fontStyle=2;fontColor=#0050ef;arcSize=2;" parent="1" vertex="1">
                    <mxGeometry x="50" y="260" width="270" height="430" as="geometry"/>
                </mxCell>
                <mxCell id="input_reg" value="&lt;b&gt;Incoming Request (e.g., rs[i])&lt;/b&gt;&#xa;Reg ID = 5 (r5, 5&#39;b001_01)&#xa;Warp ID = 2 (wis, 2&#39;b10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1e88e5;strokeWidth=2;fontFamily=Helvetica;fontColor=#0d47a1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="70" y="340" width="220" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="split_op" value="Bitwise Splitting &amp; Concat" style="shape=trapezoid;perimeter=trapezoidPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="440" width="200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="e_in_split" value="reg[4:0], wis[1:0]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;" parent="1" source="input_reg" target="split_op" edge="1">
                    <mxGeometry x="-0.3333" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="bank_sel_box" value="&lt;b&gt;req_bank_idx (Bank Select)&lt;/b&gt;&#xa;reg[1:0] (Lowest 2 bits)&#xa;e.g., 5&#39;b001_&lt;font color=&#39;red&#39;&gt;01&lt;/font&gt; -&gt; Bank 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#d81b60;strokeWidth=2;fontFamily=Helvetica;fontColor=#880e4f;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="70" y="530" width="180" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="addr_calc_box" value="&lt;b&gt;req_in_data (Addr Inside Bank)&lt;/b&gt;&#xa;{ reg[4:2], wis[1:0] }&#xa;e.g., { &lt;font color=&#39;green&#39;&gt;3&#39;b001&lt;/font&gt;, &lt;font color=&#39;blue&#39;&gt;2&#39;b10&lt;/font&gt; } -&gt; Addr 6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;strokeWidth=2;fontFamily=Helvetica;fontColor=#1b5e20;fontSize=12;" parent="1" vertex="1">
