<mxfile host="Electron" modified="2024-03-08T10:00:00.000Z" agent="Mozilla/5.0" type="device">
    <diagram id="vx_ipdom_stack" name="Split Join &amp; IPDOM Microarchitecture">
        <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>

                <!-- Main Background -->
                <mxCell id="bg" value="VX_split_join &amp; VX_ipdom_stack Internal Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1a1a1a;strokeWidth=2;dashed=1;verticalAlign=top;spacingTop=10;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#333;" vertex="1" parent="1">
                    <mxGeometry x="80" y="40" width="1020" height="740" as="geometry"/>
                </mxCell>

                <!-- Input from Scheduler -->
                <mxCell id="warp_ctl_in" value="&lt;b&gt;warp_ctl_if.split / .join&lt;/b&gt;&#xa;(valid, wid, is_dvg,&#xa;then_tmask, else_tmask, next_pc)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1e88e5;strokeWidth=2;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="-40" y="220" width="170" height="80" as="geometry"/>
                </mxCell>

                <!-- Instruction Extractor Mapping -->
                <mxCell id="extractor" value="&lt;b&gt;State Constructor&lt;/b&gt;&lt;br&gt;&lt;br&gt;q1 (Else Path) = {else_tmask, next_pc}&lt;br&gt;&lt;br&gt;q0 (Reconverge) = {then | else, 0}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;strokeWidth=2;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="170" y="220" width="220" height="80" as="geometry"/>
                </mxCell>

                <mxCell id="e_in_ext" value="" edge="1" parent="1" source="warp_ctl_in" target="extractor">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- Split Join Module Boundary -->
                <mxCell id="sj_bg" value="VX_split_join Array (NUM_WARPS instances of IPDOM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#cfd8dc;strokeWidth=2;verticalAlign=top;spacingTop=10;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
                    <mxGeometry x="440" y="80" width="620" height="480" as="geometry"/>
                </mxCell>

                <!-- IPDOM Zoom in -->
                <mxCell id="ipdom_bg" value="&lt;b&gt;VX_ipdom_stack (Instance for wid == i)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4caf50;strokeWidth=2;verticalAlign=top;spacingTop=10;fontFamily=Helvetica;fontSize=14;dashed=1;" vertex="1" parent="1">
                    <mxGeometry x="460" y="140" width="560" height="390" as="geometry"/>
                </mxCell>

                <!-- The Dual-Width RAM -->
                <mxCell id="ram_block" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;rowLines=1;columnLines=1;rounded=0;whiteSpace=wrap;html=1;strokeColor=#999;fillColor=#fafafa;" vertex="1" parent="1">
                    <mxGeometry x="720" y="170" width="260" height="150" as="geometry"/>
                </mxCell>

                <!-- RAM Headers -->
                <mxCell id="ram_h_num" value="Row" style="shape=partialRectangle;fillColor=#eeeeee;html=1;align=center;fontSize=11;strokeColor=#999;" vertex="1" parent="ram_block"><mxGeometry width="50" height="30" as="geometry"/></mxCell>
                <mxCell id="ram_h_q1" value="[WIDTH] q1 (Else State)" style="shape=partialRectangle;fillColor=#eeeeee;html=1;align=center;fontSize=11;strokeColor=#999;" vertex="1" parent="ram_block"><mxGeometry x="50" width="105" height="30" as="geometry"/></mxCell>
                <mxCell id="ram_h_q0" value="[WIDTH] q0 (Reconverge)" style="shape=partialRectangle;fillColor=#eeeeee;html=1;align=center;fontSize=11;strokeColor=#999;" vertex="1" parent="ram_block"><mxGeometry x="155" width="105" height="30" as="geometry"/></mxCell>

                <!-- RAM Row 0 -->
                <mxCell id="r0_n" value="0" style="shape=partialRectangle;fillColor=none;html=1;align=center;fontSize=11;strokeColor=#999;" vertex="1" parent="ram_block"><mxGeometry y="30" width="50" height="30" as="geometry"/></mxCell>
                <mxCell id="r0_q1" value="{else_tm, next_pc}" style="shape=partialRectangle;fillColor=none;html=1;align=center;fontSize=11;strokeColor=#999;fontColor=#b71c1c;" vertex="1" parent="ram_block"><mxGeometry x="50" y="30" width="105" height="30" as="geometry"/></mxCell>
                <mxCell id="r0_q0" value="{all_tm, 0}" style="shape=partialRectangle;fillColor=none;html=1;align=center;fontSize=11;strokeColor=#999;fontColor=#1b5e20;" vertex="1" parent="ram_block"><mxGeometry x="155" y="30" width="105" height="30" as="geometry"/></mxCell>

                <!-- RAM Row 1 -->
                <mxCell id="r1_n" value="1" style="shape=partialRectangle;fillColor=none;html=1;align=center;fontSize=11;strokeColor=#999;" vertex="1" parent="ram_block"><mxGeometry y="60" width="50" height="30" as="geometry"/></mxCell>
                <mxCell id="r1_q1" value="..." style="shape=partialRectangle;fillColor=none;html=1;align=center;fontSize=11;strokeColor=#999;" vertex="1" parent="ram_block"><mxGeometry x="50" y="60" width="105" height="30" as="geometry"/></mxCell>
                <mxCell id="r1_q0" value="..." style="shape=partialRectangle;fillColor=none;html=1;align=center;fontSize=11;strokeColor=#999;" vertex="1" parent="ram_block"><mxGeometry x="155" y="60" width="105" height="30" as="geometry"/></mxCell>
                
                <!-- RAM Row 2 -->
                <mxCell id="r2_n" value="N-1" style="shape=partialRectangle;fillColor=none;html=1;align=center;fontSize=11;strokeColor=#999;" vertex="1" parent="ram_block"><mxGeometry y="90" width="50" height="60" as="geometry"/></mxCell>
                <mxCell id="r2_q1" value="(Push writes both)" style="shape=partialRectangle;fillColor=none;html=1;align=center;fontSize=11;strokeColor=#999;" vertex="1" parent="ram_block"><mxGeometry x="50" y="90" width="105" height="60" as="geometry"/></mxCell>
                <mxCell id="r2_q0" value="simultaneously" style="shape=partialRectangle;fillColor=none;html=1;align=center;fontSize=11;strokeColor=#999;" vertex="1" parent="ram_block"><mxGeometry x="155" y="90" width="105" height="60" as="geometry"/></mxCell>

                <!-- Write / Read Pointers -->
                <mxCell id="ptr_logic" value="&lt;b&gt;Ptr &amp; Slot Logic&lt;/b&gt;&lt;br&gt;&lt;br&gt;if (push): slot_set=0, wr_ptr++&lt;br&gt;&lt;br&gt;if (pop) : read d_set_n (slot_set);&lt;br&gt;slot_set=1; &lt;br&gt;if (d_set_n==1): wr_ptr-- (Pop Row)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbf0;strokeColor=#fbc02d;strokeWidth=2;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="480" y="180" width="190" height="110" as="geometry"/>
                </mxCell>

                <!-- Push & Pop edges to ptr logic -->
                <mxCell id="e_push" value="push = split.valid &amp;&amp; is_dvg" edge="1" parent="1" target="ptr_logic">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="390" y="240" as="sourcePoint"/>
                        <Array as="points"><mxPoint x="430" y="240"/><mxPoint x="430" y="200"/></Array>
                    </mxGeometry>
                </mxCell>
                
                <mxCell id="e_pop" value="pop = sjoin.valid &amp;&amp; !empty &amp;&amp; stack_ptr_match" edge="1" parent="1" target="ptr_logic">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="390" y="240" as="sourcePoint"/>
                        <Array as="points"><mxPoint x="430" y="240"/><mxPoint x="430" y="270"/></Array>
                    </mxGeometry>
                </mxCell>

                <!-- Output Mux -->
                <mxCell id="mux_out" value="&lt;b&gt;MUX&lt;/b&gt;" style="shape=trapezoid;perimeter=trapezoidPerimeter;whiteSpace=wrap;html=1;fixedSize=1;rotation=-90;fillColor=#eeeeee;strokeColor=#36393d;strokeWidth=2;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="840" y="420" width="80" height="30" as="geometry"/>
                </mxCell>
                
                <mxCell id="e_ram1_mux" value="d1" edge="1" parent="1" source="r2_q1" target="mux_out">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points"><mxPoint x="820" y="350"/><mxPoint x="820" y="350"/></Array>
                    </mxGeometry>
                </mxCell>

                <mxCell id="e_ram0_mux" value="d0" edge="1" parent="1" source="r2_q0" target="mux_out">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points"><mxPoint x="930" y="360"/><mxPoint x="930" y="420"/></Array>
                    </mxGeometry>
                </mxCell>
                
                <mxCell id="e_mux_sel" value="d_set_r (1=d0, 0=d1)" edge="1" parent="1" source="ptr_logic" target="mux_out">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points"><mxPoint x="575" y="435"/></Array>
                    </mxGeometry>
                </mxCell>
                
                <mxCell id="e_q1q0_ram" edge="1" parent="1" source="extractor" target="ram_block">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points"><mxPoint x="280" y="120"/><mxPoint x="850" y="120"/></Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="lbl_ex_q10" value="{q1, q0}" edgeLabel="1" parent="e_q1q0_ram" connectable="0">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="10" y="-10" as="offset"/></mxGeometry>
                </mxCell>


                <!-- Output Register / Pipe -->
                <mxCell id="pipe_reg" value="&lt;b&gt;VX_pipe_register&lt;/b&gt;&#xa;(join_wid, tmask, pc, dvg)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="790" y="600" width="180" height="60" as="geometry"/>
                </mxCell>

                <mxCell id="e_mux_pipe" value="d {tmask, PC}" edge="1" parent="1" source="mux_out" target="pipe_reg">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                
                <!-- Return to Schedule -->
                <mxCell id="out_to_sched" value="&lt;b&gt;To Status Updater (VX_schedule)&lt;/b&gt;&lt;br&gt;Updates active_warps, pc, etc." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="-40" y="600" width="170" height="60" as="geometry"/>
                </mxCell>

                <mxCell id="e_pipe_out" value="join valid feedback" edge="1" parent="1" source="pipe_reg" target="out_to_sched">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- Annotation Note -->
                <mxCell id="note_box" value="&lt;b&gt;Two-Step Pop Mechanism (Crucial for IF-ELSE)&lt;/b&gt;&lt;br&gt;&#xa;- 1st Pop (Then path completes): &lt;br&gt;&#xa;    Outputs &lt;b&gt;d1&lt;/b&gt; (Else path Tmask &amp; PC). wr_ptr DOES NOT decrement. Marks slot as partially read.&lt;br&gt;&#xa;- 2nd Pop (Else path completes): &lt;br&gt;&#xa;    Outputs &lt;b&gt;d0&lt;/b&gt; (Reconvergence Tmask). wr_ptr Decrements. Row is freed." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
                    <mxGeometry x="460" y="370" width="300" height="130" as="geometry"/>
                </mxCell>

            </root>
        </mxGraphModel>
    </diagram>
</mxfile>